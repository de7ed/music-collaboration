DATABASE_URL="postgresql://postgres:postgres@localhost:5432/music_collab?schema=public"

# Clerk - get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/lyric-sheets
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/pending

# Resend - get from https://resend.com/api-keys
RESEND_API_KEY=re_...
# Local dev: use "onboarding@resend.dev" (only delivers to your verified Resend account email).
# Production: verify your domain at resend.com/domains and use noreply@yourdomain.com
RESEND_FROM_EMAIL="onboarding@resend.dev"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage: "local" for dev, "s3" for prod
STORAGE_PROVIDER="local"
